# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase (PostgreSQL database)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 (File Storage)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=ruang-files
# Public URL — enable in R2 dashboard: bucket → Settings → Public Access
CLOUDFLARE_R2_PUBLIC_URL=https://your-bucket.your-account.r2.dev

# Resend — reminder delivery AND signup email verification.
# Without RESEND_API_KEY, registration falls back to creating pre-confirmed
# accounts (see finding 6 in SECURITY_REVIEW.md). EMAIL_FROM must be a sender
# Resend has verified for your domain, or every send fails into that fallback.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Ruang <reminders@your-domain.com>
